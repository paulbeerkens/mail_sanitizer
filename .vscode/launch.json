{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Gmail Sanitizer",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": ["--archive-email", "stitchfix@e.stitchfix.com", "--max-results","500"],
      //"args": ["--email", "info@e.savedemocracypac.com"],      
      //"args": ["--frequency", "--max-results","500"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
